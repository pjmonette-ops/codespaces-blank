# SafetyAware

A mobile-first safety and emergency response application built with Next.js 15, React 19, and TypeScript.

## Features

- 🗺️ Real-time location tracking with interactive map
- 🚨 Emergency SOS button with location sharing
- 📍 Report and view safety incidents
- 👥 Emergency contacts management
- ⚠️ Persons of concern tracking with proximity alerts
- 🛡️ Real-time safety score based on nearby alerts
- 🔔 Proximity alerts when near persons of concern
- ⚙️ Customizable safety settings
- 📱 Mobile-optimized with touch gestures
- 🌙 Dark mode UI

## Getting Started

### Prerequisites

- Node.js 18+ 
- pnpm (recommended) or npm

### Installation

1. Clone the repository:
```bash
git clone <your-repo-url>
cd safetyaware
"use client"

import { useState, useEffect, useCallback } from "react"
import { MapPin, AlertTriangle, Phone, Users, Shield, Bell, UserPlus, UserX, Settings } from "lucide-react"
import { Map } from "@/components/Map"
import { EmergencyButton } from "@/components/EmergencyButton"
import { ReportIncident } from "@/components/ReportIncident"
import { AlertFeed } from "@/components/AlertFeed"
import { SafetyScore } from "@/components/SafetyScore"
import { EmergencyContacts } from "@/components/EmergencyContacts"
import { SOSLocationShare } from "@/components/SOSLocationShare"
import { PersonsOfConcern } from "@/components/PersonsOfConcern"
import { SafetySettings } from "@/components/SafetySettings"
import { ProximityAlerts } from "@/components/ProximityAlerts"
import { useLocalStorage } from "@/hooks/use-local-storage"
import { useToast } from "@/hooks/use-toast"
import type { Alert, UserLocation, EmergencyContact, SOSLocationDrop, PersonOfConcern, SafetySettings as SafetySettingsType, ProximityAlert } from "@/types"

export default function SafetyAwarePage() {
  const [userLocation, setUserLocation] = useState<UserLocation | null>(null)
  const [alerts, setAlerts] = useLocalStorage<Alert[]>("safety-alerts", [])
  const [activeView, setActiveView] = useState<"map" | "alerts" | "report" | "contacts" | "watchlist" | "settings" | "proximity">("map")
  const [emergencyContacts, setEmergencyContacts] = useLocalStorage<EmergencyContact[]>("emergency-contacts", [])
  const [personsOfConcern, setPersonsOfConcern] = useLocalStorage<PersonOfConcern[]>("persons-of-concern", [])
  const [proximityAlerts, setProximityAlerts] = useLocalStorage<ProximityAlert[]>("proximity-alerts", [])
  const [safetySettings, setSafetySettings] = useLocalStorage<SafetySettingsType>("safety-settings", {
    comfortRadius: 5,
    enableProximityAlerts: true,
    enablePushNotifications: true,
    autoShareLocation: false
  })
  const [activeSOSLocation, setActiveSOSLocation] = useState<SOSLocationDrop | null>(null)
  const [showSOSShare, setShowSOSShare] = useState(false)
  const [locationError, setLocationError] = useState<string | null>(null)
  const { toast } = useToast()

  // Vibration feedback for mobile devices (SSR-safe)
  const vibrate = useCallback((pattern: number | number[]) => {
    if (typeof window !== 'undefined' && 'vibrate' in navigator) {
      navigator.vibrate(pattern)
    }
  }, [])

  // High-accuracy location tracking for mobile devices
  useEffect(() => {
    if (typeof window !== 'undefined' && 'geolocation' in navigator) {
      // Request high accuracy location with optimized settings for mobile
      const watchId = navigator.geolocation.watchPosition(
        (position) => {
          const newLocation: UserLocation = {
            latitude: position.coords.latitude,
            longitude: position.coords.longitude,
            timestamp: Date.now(),
            accuracy: position.coords.accuracy,
            heading: position.coords.heading || undefined,
            speed: position.coords.speed || undefined
          }
          setUserLocation(newLocation)
          setLocationError(null)
        },
        (error) => {
          console.error("Location error:", error)
          let errorMessage = "Please enable location services for safety features"
          
          switch(error.code) {
            case error.PERMISSION_DENIED:
              errorMessage = "Location permission denied. Please enable in device settings."
              break
            case error.POSITION_UNAVAILABLE:
              errorMessage = "Location unavailable. Please check your GPS signal."
              break
            case error.TIMEOUT:
              errorMessage = "Location request timed out. Retrying..."
              break
          }
          
          setLocationError(errorMessage)
          toast({
            title: "Location Access Required",
            description: errorMessage,
            variant: "destructive"
          })
        },
        { 
          enableHighAccuracy: true, 
          maximumAge: 5000, // 5 seconds
          timeout: 10000 // 10 seconds
        }
      )

      return () => navigator.geolocation.clearWatch(watchId)
    }
  }, [toast])

  // Prevent body scroll on iOS when app is in use
  useEffect(() => {
    if (typeof window !== 'undefined') {
      document.body.style.overflow = 'hidden'
      document.body.style.position = 'fixed'
      document.body.style.width = '100%'
      document.body.style.height = '100%'
      
      // Prevent pull-to-refresh on mobile
      document.body.style.overscrollBehavior = 'none'
      
      return () => {
        document.body.style.overflow = ''
        document.body.style.position = ''
        document.body.style.width = ''
        document.body.style.height = ''
        document.body.style.overscrollBehavior = ''
      }
    }
  }, [])

  const calculateDistance = useCallback((lat1: number, lon1: number, lat2: number, lon2: number) => {
    const R = 6371 // Earth's radius in km
    const dLat = ((lat2 - lat1) * Math.PI) / 180
    const dLon = ((lon2 - lon1) * Math.PI) / 180
    const a =
      Math.sin(dLat / 2) * Math.sin(dLat / 2) +
      Math.cos((lat1 * Math.PI) / 180) *
        Math.cos((lat2 * Math.PI) / 180) *
        Math.sin(dLon / 2) *
        Math.sin(dLon / 2)
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a))
    return R * c
  }, [])

  const checkNearbyThreats = useCallback((location: UserLocation) => {
    const activeAlerts = alerts.filter(a => a.status === "active")
    
    const nearbyAlerts = activeAlerts.filter(alert => {
      const distance = calculateDistance(
        location.latitude,
        location.longitude,
        alert.latitude,
        alert.longitude
      )
      return distance < 0.5 // Within 500 meters
    })

    if (nearbyAlerts.length > 0 && nearbyAlerts.some(a => a.severity === "high")) {
      vibrate([200, 100, 200]) // Alert vibration pattern
      toast({
        title: "⚠️ Safety Alert",
        description: `${nearbyAlerts.length} incident(s) reported nearby. Stay vigilant.`,
        variant: "destructive"
      })
    }
  }, [alerts, calculateDistance, vibrate, toast])

  const checkProximityToPersonsOfConcern = useCallback((location: UserLocation) => {
    if (!safetySettings.enableProximityAlerts || safetySettings.comfortRadius === 0) {
      return
    }

    // In a real app, this would check against a backend service that tracks phone locations
    // For demo purposes, we'll simulate detection based on random probability
    personsOfConcern.forEach(person => {
      // Check if we already have a recent alert for this person (within last hour)
      const recentAlert = proximityAlerts.find(
        alert => alert.personId === person.id && Date.now() - alert.detectedAt < 3600000
      )

      if (recentAlert) return

      // Get effective radius for this person (custom or global)
      const effectiveRadius = person.customRadius ?? safetySettings.comfortRadius

      // Simulate random detection (5% chance per check)
      // In production, this would be real-time location data from a service
      if (Math.random() < 0.05) {
        const simulatedDistance = Math.random() * effectiveRadius
        
        const newAlert: ProximityAlert = {
          id: `proximity-${Date.now()}-${person.id}`,
          personId: person.id,
          personName: person.name,
          personPhone: person.phone,
          distance: simulatedDistance,
          detectedAt: Date.now(),
          userLocation: {
            latitude: location.latitude,
            longitude: location.longitude
          },
          acknowledged: false
        }

        setProximityAlerts([newAlert, ...proximityAlerts])

        // Strong vibration for proximity alert
        vibrate([300, 100, 300, 100, 300])

        // Show toast notification
        toast({
          title: "🚨 PROXIMITY ALERT",
          description: `${person.name} detected ${simulatedDistance.toFixed(1)} miles away!`,
          variant: "destructive"
        })

        // Auto-share location if enabled
        if (safetySettings.autoShareLocation && emergencyContacts.length > 0) {
          const sosLocationDrop: SOSLocationDrop = {
            id: `auto-sos-${Date.now()}`,
            latitude: location.latitude,
            longitude: location.longitude,
            timestamp: Date.now(),
            message: `⚠️ PROXIMITY ALERT: ${person.name} detected nearby. Auto-sharing location.`,
            sharedWith: emergencyContacts.map(c => c.id),
            expiresAt: Date.now() + (24 * 60 * 60 * 1000)
          }

          setActiveSOSLocation(sosLocationDrop)
          
          toast({
            title: "📍 Location Auto-Shared",
            description: `Emergency contacts notified of proximity alert`,
          })
        }

        // Update person's last seen location
        setPersonsOfConcern(personsOfConcern.map(p => 
          p.id === person.id 
            ? { 
                ...p, 
                lastSeenLocation: {
                  latitude: location.latitude,
                  longitude: location.longitude,
                  timestamp: Date.now()
                }
              }
            : p
        ))
      }
    })
  }, [safetySettings, personsOfConcern, proximityAlerts, emergencyContacts, vibrate, toast, setProximityAlerts, setPersonsOfConcern, setActiveSOSLocation])

  useEffect(() => {
    if (userLocation) {
      checkNearbyThreats(userLocation)
      checkProximityToPersonsOfConcern(userLocation)
    }
  }, [userLocation, checkNearbyThreats, checkProximityToPersonsOfConcern])

  const handleEmergency = useCallback(() => {
    if (!userLocation) {
      toast({
        title: "Location Required",
        description: "Cannot send emergency alert without location",
        variant: "destructive"
      })
      return
    }

    // Emergency vibration pattern
    vibrate([500, 200, 500, 200, 500])

    // Create emergency alert
    const newAlert: Alert = {
      id: Date.now().toString(),
      type: "emergency",
      severity: "high",
      latitude: userLocation.latitude,
      longitude: userLocation.longitude,
      description: "Emergency SOS activated",
      timestamp: Date.now(),
      status: "active",
      reportedBy: "user"
    }

    setAlerts([newAlert, ...alerts])

    // Create SOS location drop
    const sosLocationDrop: SOSLocationDrop = {
      id: `sos-${Date.now()}`,
      latitude: userLocation.latitude,
      longitude: userLocation.longitude,
      timestamp: Date.now(),
      message: "🚨 EMERGENCY: I need immediate assistance! Please check my location.",
      sharedWith: emergencyContacts.map(c => c.id),
      expiresAt: Date.now() + (24 * 60 * 60 * 1000) // 24 hours
    }

    setActiveSOSLocation(sosLocationDrop)
    setShowSOSShare(true)

    // Notify emergency contacts
    if (emergencyContacts.length > 0) {
      toast({
        title: "🚨 Emergency Alert Sent",
        description: `Location shared with ${emergencyContacts.length} emergency contact${emergencyContacts.length !== 1 ? 's' : ''}`,
        variant: "destructive"
      })
    } else {
      toast({
        title: "🚨 Emergency Alert Active",
        description: "Add emergency contacts to share your location",
        variant: "destructive"
      })
    }
  }, [userLocation, alerts, emergencyContacts, vibrate, toast, setAlerts])

  const handleReportIncident = useCallback((alert: Omit<Alert, "id" | "timestamp" | "reportedBy">) => {
    const newAlert: Alert = {
      ...alert,
      id: Date.now().toString(),
      timestamp: Date.now(),
      reportedBy: "user"
    }

    setAlerts([newAlert, ...alerts])

    vibrate(200) // Success feedback

    toast({
      title: "✅ Incident Reported",
      description: "Your report has been shared with the community",
    })

    setActiveView("alerts")
  }, [alerts, vibrate, toast, setAlerts])

  const handleAddContact = useCallback((contact: Omit<EmergencyContact, "id">) => {
    const newContact: EmergencyContact = {
      ...contact,
      id: `contact-${Date.now()}`
    }
    setEmergencyContacts([...emergencyContacts, newContact])
    vibrate(100)
    toast({
      title: "✅ Contact Added",
      description: `${contact.name} added to emergency contacts`,
    })
  }, [emergencyContacts, vibrate, toast, setEmergencyContacts])

  const handleDeleteContact = useCallback((id: string) => {
    const contact = emergencyContacts.find(c => c.id === id)
    setEmergencyContacts(emergencyContacts.filter(c => c.id !== id))
    toast({
      title: "Contact Removed",
      description: `${contact?.name} removed from emergency contacts`,
    })
  }, [emergencyContacts, toast, setEmergencyContacts])

  const handleAddPerson = useCallback((person: Omit<PersonOfConcern, "id" | "addedAt">) => {
    const newPerson: PersonOfConcern = {
      ...person,
      id: `person-${Date.now()}`,
      addedAt: Date.now()
    }
    setPersonsOfConcern([...personsOfConcern, newPerson])
    vibrate(100)
    toast({
      title: "✅ Added to Watchlist",
      description: `${person.name} is now being monitored`,
    })
  }, [personsOfConcern, vibrate, toast, setPersonsOfConcern])

  const handleDeletePerson = useCallback((id: string) => {
    const person = personsOfConcern.find(p => p.id === id)
    setPersonsOfConcern(personsOfConcern.filter(p => p.id !== id))
    // Also remove related proximity alerts
    setProximityAlerts(proximityAlerts.filter(a => a.personId !== id))
    toast({
      title: "Removed from Watchlist",
      description: `${person?.name} is no longer being monitored`,
    })
  }, [personsOfConcern, proximityAlerts, toast, setPersonsOfConcern, setProximityAlerts])

  const handleUpdatePerson = useCallback((id: string, updates: Partial<PersonOfConcern>) => {
    setPersonsOfConcern(personsOfConcern.map(p => p.id === id ? { ...p, ...updates } : p))
  }, [personsOfConcern, setPersonsOfConcern])

  const handleAcknowledgeProximityAlert = useCallback((id: string) => {
    setProximityAlerts(proximityAlerts.map(a => 
      a.id === id ? { ...a, acknowledged: true } : a
    ))
    vibrate(50)
    toast({
      title: "Alert Acknowledged",
      description: "Proximity alert has been marked as read",
    })
  }, [proximityAlerts, vibrate, toast, setProximityAlerts])

  const handleUpdateSettings = useCallback((settings: SafetySettingsType) => {
    setSafetySettings(settings)
    vibrate(100)
    toast({
      title: "✅ Settings Saved",
      description: "Your safety preferences have been updated",
    })
  }, [vibrate, toast, setSafetySettings])

  const unacknowledgedProximityAlerts = proximityAlerts.filter(a => !a.acknowledged)

  const handleAlertClick = useCallback((alert: Alert) => {
    vibrate(50)
    toast({
      title: alert.type.toUpperCase(),
      description: alert.description,
    })
  }, [vibrate, toast])

  const handleResolveAlert = useCallback((id: string) => {
    setAlerts(alerts.map(a => a.id === id ? { ...a, status: "resolved" as const } : a))
    vibrate(100)
  }, [alerts, vibrate, setAlerts])

  return (
    <div className="h-[100dvh] flex flex-col bg-[#0a0e1a] touch-manipulation">
      {/* Header */}
      <header className="gradient-danger text-white p-4 shadow-lg safe-area-top">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-2">
            <Shield className="w-6 h-6" />
            <h1 className="text-xl font-bold">SafetyAware</h1>
          </div>
          <div className="flex items-center gap-3">
            <button
              onClick={() => {
                vibrate(50)
                setActiveView("settings")
              }}
              className="relative hover:opacity-80 transition-opacity active:scale-95 touch-target"
              aria-label="Settings"
            >
              <Settings className="w-5 h-5" />
            </button>
            <button
              onClick={() => {
                vibrate(50)
                setActiveView("proximity")
              }}
              className="relative hover:opacity-80 transition-opacity active:scale-95 touch-target"
              aria-label="Proximity alerts"
            >
              <Bell className="w-5 h-5" />
              {unacknowledgedProximityAlerts.length > 0 && (
                <span className="absolute -top-1 -right-1 bg-amber-500 text-white text-xs rounded-full w-4 h-4 flex items-center justify-center animate-pulse-glow">
                  {unacknowledgedProximityAlerts.length}
                </span>
              )}
            </button>
            {userLocation && (
              <div className="text-xs bg-white/20 px-2 py-1 rounded backdrop-blur-sm">
                <MapPin className="w-3 h-3 inline mr-1" />
                {userLocation.accuracy && userLocation.accuracy < 50 ? 'High' : 'Low'} Accuracy
              </div>
            )}
          </div>
        </div>
      </header>

      {/* Main Content */}
      <main className="flex-1 relative overflow-hidden">
        {activeView === "map" && (
          <Map
            userLocation={userLocation}
            alerts={alerts}
            onAlertClick={handleAlertClick}
          />
        )}

        {activeView === "alerts" && (
          <AlertFeed
            alerts={alerts}
            userLocation={userLocation}
            onResolve={handleResolveAlert}
          />
        )}

        {activeView === "report" && (
          <ReportIncident
            userLocation={userLocation}
            onSubmit={handleReportIncident}
            onCancel={() => setActiveView("map")}
          />
        )}

        {activeView === "contacts" && (
          <EmergencyContacts
            contacts={emergencyContacts}
            onAddContact={handleAddContact}
            onDeleteContact={handleDeleteContact}
            onClose={() => setActiveView("map")}
          />
        )}

        {activeView === "watchlist" && (
          <PersonsOfConcern
            persons={personsOfConcern}
            onAddPerson={handleAddPerson}
            onDeletePerson={handleDeletePerson}
            onUpdatePerson={handleUpdatePerson}
            onClose={() => setActiveView("map")}
            comfortRadius={safetySettings.comfortRadius}
            onOpenSettings={() => setActiveView("settings")}
          />
        )}

        {activeView === "settings" && (
          <SafetySettings
            settings={safetySettings}
            onUpdateSettings={handleUpdateSettings}
            onClose={() => setActiveView("map")}
          />
        )}

        {activeView === "proximity" && (
          <ProximityAlerts
            alerts={proximityAlerts}
            persons={personsOfConcern}
            onAcknowledge={handleAcknowledgeProximityAlert}
            onClose={() => setActiveView("map")}
          />
        )}

        {/* Safety Score Overlay (only on map view) */}
        {activeView === "map" && userLocation && (
          <SafetyScore
            alerts={alerts}
            userLocation={userLocation}
          />
        )}

        {/* Emergency Button (always visible) */}
        <EmergencyButton onEmergency={handleEmergency} />
      </main>

      {/* SOS Location Share Modal */}
      {showSOSShare && activeSOSLocation && userLocation && (
        <SOSLocationShare
          location={userLocation}
          contacts={emergencyContacts}
          locationDrop={activeSOSLocation}
          onClose={() => setShowSOSShare(false)}
        />
      )}

      {/* Bottom Navigation */}
      <nav className="bg-[#151b2e] border-t border-slate-800/50 px-2 py-3 safe-area-bottom backdrop-blur-xl">
        <div className="flex justify-around items-center">
          <button
            onClick={() => {
              vibrate(50)
              setActiveView("map")
            }}
            className={`flex flex-col items-center gap-1 px-3 py-2 rounded-lg transition-all active:scale-95 touch-target ${
              activeView === "map"
                ? "bg-gradient-to-br from-red-600 to-orange-600 text-white shadow-lg"
                : "text-slate-400 hover:text-white hover:bg-slate-800/50"
            }`}
            aria-label="Map view"
          >
            <MapPin className="w-5 h-5" />
            <span className="text-xs font-medium">Map</span>
          </button>

          <button
            onClick={() => {
              vibrate(50)
              setActiveView("alerts")
            }}
            className={`flex flex-col items-center gap-1 px-3 py-2 rounded-lg transition-all relative active:scale-95 touch-target ${
              activeView === "alerts"
                ? "bg-gradient-to-br from-red-600 to-orange-600 text-white shadow-lg"
                : "text-slate-400 hover:text-white hover:bg-slate-800/50"
            }`}
            aria-label="Alerts"
          >
            <AlertTriangle className="w-5 h-5" />
            <span className="text-xs font-medium">Alerts</span>
            {alerts.filter(a => a.status === "active").length > 0 && (
              <span className="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center shadow-lg">
                {alerts.filter(a => a.status === "active").length}
              </span>
            )}
          </button>

          <button
            onClick={() => {
              vibrate(50)
              setActiveView("watchlist")
            }}
            className={`flex flex-col items-center gap-1 px-3 py-2 rounded-lg transition-all relative active:scale-95 touch-target ${
              activeView === "watchlist"
                ? "bg-gradient-to-br from-red-600 to-orange-600 text-white shadow-lg"
                : "text-slate-400 hover:text-white hover:bg-slate-800/50"
            }`}
            aria-label="Watchlist"
          >
            <UserX className="w-5 h-5" />
            <span className="text-xs font-medium">Watch</span>
            {personsOfConcern.length > 0 && (
              <span className="absolute -top-1 -right-1 bg-amber-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center shadow-lg">
                {personsOfConcern.length}
              </span>
            )}
          </button>

          <button
            onClick={() => {
              vibrate(50)
              setActiveView("report")
            }}
            className={`flex flex-col items-center gap-1 px-3 py-2 rounded-lg transition-all active:scale-95 touch-target ${
              activeView === "report"
                ? "bg-gradient-to-br from-red-600 to-orange-600 text-white shadow-lg"
                : "text-slate-400 hover:text-white hover:bg-slate-800/50"
            }`}
            aria-label="Report incident"
          >
            <Phone className="w-5 h-5" />
            <span className="text-xs font-medium">Report</span>
          </button>

          <button
            onClick={() => {
              vibrate(50)
              setActiveView("contacts")
            }}
            className={`flex flex-col items-center gap-1 px-3 py-2 rounded-lg transition-all relative active:scale-95 touch-target ${
              activeView === "contacts"
                ? "bg-gradient-to-br from-red-600 to-orange-600 text-white shadow-lg"
                : "text-slate-400 hover:text-white hover:bg-slate-800/50"
            }`}
            aria-label="Emergency contacts"
          >
            <UserPlus className="w-5 h-5" />
            <span className="text-xs font-medium">Contacts</span>
            {emergencyContacts.length === 0 && (
              <span className="absolute -top-1 -right-1 bg-amber-500 w-2 h-2 rounded-full animate-pulse" />
            )}
          </button>
        </div>
      </nav>
    </div>
  )
}
